# Agent Farm 只会为尚未设置的 key 补值。共享 load-env 在 db.ts 解析 data dir
# 之前运行，因此这里的 AGENT_FARM_DATA_DIR 会选择实际打开的 SQLite。
# 启动优先级：shell env > server/.env > ~/.claude/settings.json 的 env。
# 设 AGENT_FARM_DISABLE_USER_SETTINGS=1 可禁止读取用户 settings。
# 注意：SDK query 使用 settingSources=[]；settings 文件不会再为单次 Agent run
# 加载额外 behavior，只能在 server 启动阶段按上述规则补 env。

# ─── Server runtime ───
# AGENT_FARM_DATA_DIR=/absolute/path/to/agent-farm-data
# HOST=127.0.0.1
# PORT=7878
# AGENT_FARM_RUN_TIMEOUT_MS=1800000
# AGENT_FARM_MAX_BUDGET_USD=5
# AGENT_FARM_STALE_RUN_MS=300000
# AGENT_FARM_JSON_LIMIT=2mb
# AGENT_FARM_DIFF_RESPONSE_MAX_BYTES=4194304
# AGENT_FARM_DISABLE_USER_SETTINGS=1

# ─── Git commit identity ───
# 以下是标准 Git env，不是 Agent Farm 私有变量。未设置时当前 Git 层 fallback 为
# Agent Farm <agent-farm@localhost>；正式仓库建议显式覆盖为可审计身份。
# GIT_AUTHOR_NAME=Agent Farm
# GIT_AUTHOR_EMAIL=agent-farm@example.invalid
# GIT_COMMITTER_NAME=Agent Farm
# GIT_COMMITTER_EMAIL=agent-farm@example.invalid

# ─── Anthropic direct credential ───
# ANTHROPIC_API_KEY=sk-ant-...
# 或：
# ANTHROPIC_AUTH_TOKEN=...
# 或：
# CLAUDE_CODE_OAUTH_TOKEN=...

# ─── Custom Anthropic-compatible endpoint ───
# 必须同时配置一个上面的 direct credential，Agent Farm 才识别 custom endpoint。
# ANTHROPIC_BASE_URL=https://your-gateway.example/

# ─── Explicit Anthropic profile / workload identity ───
# Agent Farm 不会仅凭磁盘上的默认 profile 判定 provider 可用；需显式选择。
# ANTHROPIC_PROFILE=your-profile
#
# WIF 必须完整提供 federation rule、organization、service account 和 identity token 来源。
# ANTHROPIC_FEDERATION_RULE_ID=...
# ANTHROPIC_ORGANIZATION_ID=...
# ANTHROPIC_SERVICE_ACCOUNT_ID=...
# ANTHROPIC_IDENTITY_TOKEN=...
# 或：
# ANTHROPIC_IDENTITY_TOKEN_FILE=/absolute/path/to/identity-token

# ─── Cloud provider switches ───
# Agent Farm 识别以下值恰为 1 的 provider flags；云 SDK 所需 region/project/profile
# 等附加变量由对应 provider/Claude Agent SDK 消费，请按当前 provider 文档配置。
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_MANTLE=1
# CLAUDE_CODE_USE_VERTEX=1
# CLAUDE_CODE_USE_FOUNDRY=1
# CLAUDE_CODE_USE_ANTHROPIC_AWS=1

# 常见 provider 侧配置示例（Agent Farm 源码本身不校验这些键）：
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
# CLOUD_ML_REGION=us-east5
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project

# Model 不从 ANTHROPIC_MODEL 读取。当前 server 通过 start/retry/recover 的 JSON body
# 字段 model 传给 Claude Agent SDK；省略时由 SDK/provider 选择默认 model。
#
# 不要把 secret 写入 Git、audit payload、benchmark、E2E proof 或日志。
# Provider preflight ready 只表示可以尝试；运行时 401/403 仍必须记录为 provider_blocked。
